rules_version = '2';

// Só a conta dona escreve. Troque SEU_UID pelo UID que a página mostra no primeiro login
// e publique em Firestore Database > Regras.

service cloud.firestore {
  match /databases/{database}/documents {

    function ehDona() {
      return request.auth != null && request.auth.uid == "SEU_UID";
    }

    match /roadmaps/{rota} {
      // Leitura pública: qualquer pessoa com o link vê o seu progresso (bom para o LinkedIn).
      // Para deixar privado, troque "true" por "ehDona()" aqui e no histórico.
      allow read: if true;
      allow create: if ehDona() && request.resource.data.donaUid == request.auth.uid;
      allow update: if ehDona();
      allow delete: if false;

      match /historico/{evento} {
        allow read: if true;
        allow create: if ehDona();
        allow update, delete: if false;
      }
    }

    // Endereço da PDI: só a dona lê e escreve.
    match /privado/{doc} {
      allow read, write: if ehDona();
    }
  }
}
